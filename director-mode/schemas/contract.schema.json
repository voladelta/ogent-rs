{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectorContract",
  "type": "object",
  "required": [
    "id",
    "kind",
    "task",
    "constraints",
    "expected_output"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "task",
        "dispatch"
      ]
    },
    "role": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "original_prompt": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_output": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_moves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
